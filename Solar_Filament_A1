e) > 0, (\n        f\"No positive tile for channel {channel}\"\n    )\n\n    assert len(negative) > 0, (\n        f\"No negative tile for channel {channel}\"\n    )\n\n    selected.extend([\n        int(positive[0]),\n        int(negative[0])\n    ])\n\nselected_indices = torch.tensor(\n    sorted(set(selected)),\n    dtype=torch.long\n)\n\nx_raw = flat_images[selected_indices]\ny_raw = flat_targets[selected_indices]\n\nprint(\"Selected tile indices:\", selected_indices.tolist())\nprint(\"Selected input shape:\", tuple(x_raw.shape))\nprint(\"Selected target shape:\", tuple(y_raw.shape))\nprint(\"Target foreground counts:\\n\", y_raw.sum(dim=(-2, -1)))\n\nassert x_raw.shape[0] >= 2\nassert y_raw.shape[1] == 2","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Test synchronized augmentation","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# A1 TWO-CHANNEL AUGMENTATION TEST\n# ============================================================\n\nbefore_counts = y_raw.sum(dim=(-2, -1))\n\nx_test, y_test = augment_and_normalize(\n    x_raw,\n    y_raw,\n    mean=normalization_stats[\"mean\"],\n    std=normalization_stats[\"std\"],\n    training=True\n)\n\nafter_counts = y_test.sum(dim=(-2, -1))\n\nassert x_test.shape == (\n    len(selected_indices), 1, 512, 512\n)\n\nassert y_test.shape == (\n    len(selected_indices), 2, 512, 512\n)\n\nassert torch.isfinite(x_test).all()\nassert torch.isfinite(y_test).all()\n\n# Rotation and reflection must preserve binary target pixel counts.\nassert torch.equal(before_counts, after_counts)\n\nassert set(\n    torch.unique(y_test).tolist()\n).issubset({0.0, 1.0})\n\nprint(\"Image tensor:\", tuple(x_test.shape))\nprint(\"Target tensor:\", tuple(y_test.shape))\nprint(\"Target counts preserved:\", True)\n\nprint(\"\\nA1 two-channel augmentation: PASSED\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":