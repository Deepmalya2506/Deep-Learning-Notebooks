ut shape:\", inference_image.shape)\nprint(\"Input dtype:\", inference_image.dtype)\nprint(\"Probability map:\", a1_probability.shape)\n\nprint(\"Probability minimum:\", float(a1_probability.min()))\nprint(\"Probability maximum:\", float(a1_probability.max()))\nprint(\"Mean probability:\", float(a1_probability.mean()))\n\nprint(\n    \"Foreground coverage at 0.5:\",\n    float((a1_probability >= 0.5).mean())\n)\n\nassert a1_probability.shape == (2048, 2048)\nassert np.isfinite(a1_probability).all()\nassert a1_probability.min() >= 0\nassert a1_probability.max() <= 1\n\nprint(\"\\nA1.12 FULL-IMAGE INFERENCE: PASSED\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Validator Evaluator","metadata":{}},{"cell_type":"code","source":"# A1 wrapper around the existing all-annotator evaluator.\n\ndef validate_a1(\n    model,\n    val_loader,\n    device,\n    threshold=0.5\n):\n    return validate_a0(\n        model=model,\n        val_loader=val_loader,\n        device=device,\n        threshold=threshold\n    )","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Save Artifacts\n\nWe need to protect the run against a kernel interruption. Our existing artifact system already supplies RUN_ROOT, CHECKPOINT_DIR, LOG_DIR, MANIFEST_DIR, atomic_torch_save() and atomic_json_save(). We will use those paths and functions rather than create a second experiment directory.","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# A1.14: TRAINING CONFIGURATION AND RECOVERY PATHS\n# ============================================================\n\nimport os\nimport time\nimport random\nimport zipfile\nimport pandas as pd\n\nfrom pathlib import Path\nfrom torch.nn.utils import clip_grad_norm_\n\n\nA1_LAST_CHECKPOINT = CHECKPOINT_DIR / \"a1_last.pt\"\nA1_BEST_CHECKPOINT = CHECKPOINT_DIR / \"a1_best.pt\"\n\nA1_HISTORY_FILE = LOG_DIR / \"a1_history.csv\"\n\nA1_RECOVERY_DIR = RUN_ROOT / \"recovery_bundles\"\nA1_RECOVERY_DIR.mkdir(parents=True, exist_ok=True)\n\nA1_MAX_EPOCHS = 24\nA1_VALIDATION_INTERVAL = 3\nA1_EARLY_STOPPING_CHECKS = 3\n\nA1_MICRO_BATCH_SIZE = 8\nA1_GRADIENT_CLIP = 1.0\n\nA1_LAMBDA_SPINE = 0.2\nA1_SPINE_POS_WEIGHT = float(spine_pos_weight)\n\nA1_INITIAL_SCALE = float(A1_INITIAL_SCALE)\n\nassert A1_INITIAL_SCALE > 0\nassert len(a1_train_dataset) == 565\nassert len(a1_val_dataset) == 142\nassert a1_train_loader.num_workers == 0\n\n# Verify inference uses the same normalization as training.\nassert np.isclose(MEAN, normalization_stats[\"mean\"])\nassert np.isclose(STD, normalization_stats[\"std\"])\n\nA1_CONFIG.update({\n\n    \"max_epochs\": A1_MAX_EPOCHS,\n\n    \"validation_interval\": A1_VALIDATION_INTERVAL,\n\n    \"early_stopping_validation_checks\": A1_EARLY_STOPPING_CHECKS,\n\n    \"photo_batch_size\": 2,\n\n    \"tile_micro_batch\": A1_MICRO_BATCH_SIZE,\n\n    \"learning_rate\": 3e-4,\n\n    \"weight_decay\": 1e-4,\n\n    \"gradient_clip\": A1_GRADIENT_CLIP,\n\n    \"lambda_spine\": A1_LAMBDA_SPINE,\n\n    \"spine_pos_weight\": A1_SPINE_POS_WEIGHT,\n\n    \"optimizer\": \"AdamW\",\n\n    \"scheduler\": {\n        \"type\": \"ReduceLROnPlateau\",\n        \"mode\": \"max\",\n        \"factor\": 0.5,\n        \"patience\": 1,\n        \"min_lr\": 1e-6\n    },\n\n    \"amp\": True,\n\n    \"amp_dtype\": \"float16\",\n\n    \"amp_initial_scale\": A1_INITIAL_SCALE,\n\n    \"amp_growth_interval\": 2000,\n\n    \"validation_metric\": \"mean_photo_dice\",\n\n    \"validation_threshold\": 0.5,\n\n    \"checkpoint_policy\": (\n        \"Atomic last checkpoint every epoch; \"\n        \"best checkpoint on validation improvement\"\n    ),\n\n    \"recovery_bundle_interval\": 3\n\n})\n\natomic_json_save(\n    A1_CONFIG,\n    RUN_ROOT / \"experiment_config.json\"\n)\n\n\ndef a1_atomic_csv_save(dataframe, destination):\n\n    destination = Path(destination)\n\n    temporary = destination.with_suffix(\n        destination.suffix + \".tmp\"\n    )\n\n    dataframe.to_csv(\n        temporary,\n        index=False\n    )\n\n    os.replace(\n        temporary,\n        destination\n    )\n\n\nprint(\"=\" * 65)\nprint(\"A1 TRAINING CONFIGURATION\")\nprint(\"=\" * 65)\n\nprint(\"Run:\", RUN_ID)\nprint(\"Output:\", RUN_ROOT)\nprint(\"Best checkpoint:\", A1_BEST_CHECKPOINT)\nprint(\"Last checkpoint:\", A1_LAST_CHECKPOINT)\nprint(\"History:\", A1_HISTORY_FILE)\nprint(\"Recovery bundles:\", A1_RECOVERY_DIR)\n\nprint(\"Initial AMP scale:\", A1_INITIAL_SCALE)\nprint(\"Microbatch size:\", A1_MICRO_BATCH_SIZE)\nprint(\"Maximum epochs:\", A1_MAX_EPOCHS)\n\nprint(\"\\nA1.14 CONFIGURATION: PASSED\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Implement the training engine\n\nThe important part of this loop is the gradient accumulation.\n\nFor one two-photo batch, we have 50 tiles. We process them as 7 microbatches: (6 batches: 8tiles + 1 batch: 2tiles)\n\nOne Optimizer Update -> Accumulate Gradient(Each microbatch contributes proportionally to its tile count) -> Unscale → clip → optimizer step(One AdamW update for all 50 tiles)\n\nThe loss contribution of each microbatch is weighted by:\n$$\nw_i=\\frac{\\text{number of tiles in microbatch }i}{\\text{total tiles in photo batch}}\n$$\n\nSo the final accumulated gradient represents the mean loss over all 50 tiles, including the smaller final microbatch.","metadata":{}},{"cell_type":"code","source":"## Training Helper\n\n# ============================================================\n# A1.15: A1 TRAINING ENGINE\n# ============================================================\n\n\ndef a1_cpu_state_dict(model):\n\n    return {\n        key: value.detach().cpu().clone()\n        for key, value in model.state_dict().items()\n    }\n\n\ndef a1_make_checkpoint(\n    epoch,\n    model,\n    optimizer,\n    scheduler,\n    scaler,\n    best_score,\n    bad_validation_checks,\n    consecutive_skips,\n    history,\n    train_loader,\n    last_validation_summary\n):\n\n    loader_rng = (\n        train_loader.generator.get_state().cpu()\n        if train_loader.generator is not None\n        else None\n    )\n\n    return {\n\n        \"run_id\": RUN_ID,\n\n        \"epoch\": epoch,\n\n        \"model_state_dict\": a1_cpu_state_dict(model),\n\n        \"optimizer_state_dict\": optimizer.state_dict(),\n\n        \"scheduler_state_dict\": scheduler.state_dict(),\n\n        \"scaler_state_dict\": scaler.state_dict(),\n\n        \"best_score\": best_score,\n\n        \"bad_validation_checks\": bad_validation_checks,\n\n        \"consecutive_skips\": consecutive_skips,\n\n        \"history\": history,\n\n        \"last_validation_summary\": last_validation_summary,\n\n        \"loader_generator_state\": loader_rng,\n\n        \"torch_rng_state\": torch.get_rng_state(),\n\n        \"cuda_rng_states\": torch.cuda.get_rng_state_all(),\n\n        \"numpy_rng_state\": np.random.get_state(),\n\n        \"python_rng_state\": random.getstate(),\n\n        \"normalization_stats\": normalization_stats,\n\n        \"target_statistics\": target_statistics,\n\n        \"config\": A1_CONFIG\n\n    }\n\n\ndef a1_save_recovery_bundle(epoch):\n\n    \"\"\"\n    Packages the current full-resume checkpoint, best model,\n    logs, config, target statistics and fold manifests.\n\n    The ZIP is written to a temporary file and atomically renamed.\n    \"\"\"\n\n    archive_path = (\n        A1_RECOVERY_DIR\n        / f\"a1_recovery_epoch_{epoch:03d}.zip\"\n    )\n\n    temporary_path = archive_path.with_suffix(\n        \".zip.tmp\"\n    )\n\n    files_to_include = [\n\n        A1_LAST_CHECKPOINT,\n\n        A1_BEST_CHECKPOINT,\n\n        A1_HISTORY_FILE,\n\n        RUN_ROOT / \"experiment_config.json\",\n\n        RUN_ROOT / \"target_statistics.json\",\n\n        MANIFEST_DIR / \"folds_photo_level.csv\",\n\n        MANIFEST_DIR / \"folds_batch_level.csv\",\n\n        MANIFEST_DIR / \"folds_annotation_level.csv\",\n\n        MANIFEST_DIR / \"target_cache_index.csv\"\n\n    ]\n\n    files_to_include = [\n        path for path in files_to_include\n        if path.exists()\n    ]\n\n    with zipfile.ZipFile(\n        temporary_path,\n        mode=\"w\",\n        compression=zipfile.ZIP_STORED,\n        allowZip64=True\n    ) as archive:\n\n        for path in files_to_include:\n\n            archive.write(\n                path,\n                arcname=str(\n                    path.relative_to(RUN_ROOT)\n                )\n            )\n\n    os.replace(\n        temporary_path,\n        archive_path\n    )\n\n    print(\n        \"\\nRecovery bundle created:\",\n        archive_path\n    )\n\n    print(\n        \"Bundle size:\",\n        round(archive_path.stat().st_size / 1024**2, 2),\n        \"MiB\"\n    )\n\n    return archive_path\n\n\n# ------------------------------------------------------------\n# Validation uses the existing full-image implementation.\n# ------------------------------------------------------------\n\ndef validate_a1(\n    model,\n    val_loader,\n    device,\n    threshold=0.5\n):\n\n    return validate_a0(\n        model=model,\n        val_loader=val_loader,\n        device=device,\n        threshold=threshold\n    )\n\n\nprint(\"A1 checkpoint and validation helpers initialized.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"## ACtual Training Function\n\ndef train_a1(\n    model,\n    train_loader,\n    val_loader,\n    max_epochs=24,\n    resume=False\n):\n\n    # --------------------------------------------------------\n    # 1. Verify the training environment\n    # --------------------------------------------------------\n\n    assert device.type == \"cuda\"\n    assert train_loader.num_workers == 0\n\n    assert A1_CONFIG[\"output_channels\"] == 2\n\n    optimizer = torch.optim.AdamW(\n        model.parameters(),\n        lr=A1_CONFIG[\"learning_rate\"],\n        weight_decay=A1_CONFIG[\"weight_decay\"]\n    )\n\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer,\n        mode=\"max\",\n        factor=0.5,\n        patience=1,\n        min_lr=1e-6\n    )\n\n    scaler = torch.amp.GradScaler(\n        \"cuda\",\n        init_scale=A1_INITIAL_SCALE,\n        growth_interval=2000,\n        enabled=True\n    )\n\n    start_epoch = 1\n\n    best_score = -float(\"inf\")\n\n    bad_validation_checks = 0\n\n    consecutive_skips = 0\n\n    history = []\n\n    last_validation_summary = None\n\n\n    # --------------------------------------------------------\n    # 2. Fresh run or resume\n    # --------------------------------------------------------\n\n    if resume:\n\n        if not A1_LAST_CHECKPOINT.exists():\n\n            raise FileNotFoundError(\n                \"Cannot resume: A1 last checkpoint does not exist.\"\n            )\n\n        checkpoint = torch.load(\n            A1_LAST_CHECKPOINT,\n            map_location=\"cpu\",\n            weights_only=False\n        )\n\n        if checkpoint[\"run_id\"] != RUN_ID:\n\n            raise ValueError(\n                \"Checkpoint belongs to a different experiment.\"\n            )\n\n        model.load_state_dict(\n            checkpoint[\"model_state_dict\"]\n        )\n\n        optimizer.load_state_dict(\n            checkpoint[\"optimizer_state_dict\"]\n        )\n\n        scheduler.load_state_dict(\n            checkpoint[\"scheduler_state_dict\"]\n        )\n\n        scaler.load_state_dict(\n            checkpoint[\"scaler_state_dict\"]\n        )\n\n        start_epoch = checkpoint[\"epoch\"] + 1\n\n        best_score = checkpoint[\"best_score\"]\n\n        bad_validation_checks = (\n            checkpoint[\"bad_validation_checks\"]\n        )\n\n        consecutive_skips = (\n            checkpoint[\"consecutive_skips\"]\n        )\n\n        history = checkpoint[\"history\"]\n\n        last_validation_summary = (\n            checkpoint[\"last_validation_summary\"]\n        )\n\n        if (\n            checkpoint[\"loader_generator_state\"] is not None\n            and train_loader.generator is not None\n        ):\n\n            train_loader.generator.set_state(\n                checkpoint[\"loader_generator_state\"]\n            )\n\n        torch.set_rng_state(\n            checkpoint[\"torch_rng_state\"].cpu()\n        )\n\n        torch.cuda.set_rng_state_all(\n            [\n                state.cpu()\n                for state in checkpoint[\"cuda_rng_states\"]\n            ]\n        )\n\n        np.random.set_state(\n            checkpoint[\"numpy_rng_state\"]\n        )\n\n        random.setstate(\n            checkpoint[\"python_rng_state\"]\n        )\n\n        print(\n            f\"Resuming A1 from epoch {start_epoch}\"\n        )\n\n        print(\n            f\"Previous best validation Dice: {best_score:.6f}\"\n        )\n\n    else:\n\n        if (\n            A1_LAST_CHECKPOINT.exists()\n            or A1_BEST_CHECKPOINT.exists()\n        ):\n\n            raise FileExistsError(\n                \"A1 checkpoint already exists. \"\n                \"Use resume=True or move the previous run.\"\n            )\n\n        random.seed(A1_SEED)\n        np.random.seed(A1_SEED)\n\n        torch.manual_seed(A1_SEED)\n        torch.cuda.manual_seed_all(A1_SEED)\n\n        if train_loader.generator is not None:\n\n            train_loader.generator.manual_seed(\n                A1_SEED\n            )\n\n        print(\"Starting a fresh A1 run.\")\n\n\n    # --------------------------------------------------------\n    # 3. Epoch loop\n    # --------------------------------------------------------\n\n    for epoch in range(start_epoch, max_epochs + 1):\n\n        epoch_start = time.time()\n\n        train_loader.dataset.set_epoch(epoch)\n\n        model.train()\n\n        torch.cuda.reset_peak_memory_stats(device)\n\n        metric_names = [\n\n            \"total\",\n            \"mask_loss\",\n            \"mask_bce\",\n            \"mask_dice\",\n            \"spine_loss\",\n            \"spine_bce\",\n            \"spine_dice\"\n\n        ]\n\n        epoch_sums = {\n            name: 0.0\n            for name in metric_names\n        }\n\n        total_tile_count = 0\n\n        successful_updates = 0\n        skipped_updates = 0\n\n        gradient_norm_sum = 0.0\n        gradient_norm_count = 0\n\n        optimizer.zero_grad(set_to_none=True)\n\n        print(\"\\n\" + \"=\" * 75)\n        print(f\"A1 — EPOCH {epoch}/{max_epochs}\")\n        print(\"=\" * 75)\n\n\n        # ----------------------------------------------------\n        # 4. Iterate over physical-photo batches\n        # ----------------------------------------------------\n\n        for step, batch in enumerate(train_loader):\n\n            # [2, 25, C, 512, 512]\n            # becomes [50, C, 512, 512]\n\n            images = batch[\"images\"].reshape(\n                -1, 1, 512, 512\n            )\n\n            targets = batch[\"targets\"].reshape(\n                -1, 2, 512, 512\n            )\n\n            n_tiles = images.shape[0]\n\n            assert targets.shape[0] == n_tiles\n\n            optimizer.zero_grad(set_to_none=True)\n\n            batch_loss_values = {\n                name: 0.0\n                for name in metric_names\n            }\n\n\n            # ------------------------------------------------\n            # 5. Microbatch gradient accumulation\n            # ------------------------------------------------\n\n            for start in range(\n                0,\n                n_tiles,\n                A1_MICRO_BATCH_SIZE\n            ):\n\n                end = min(\n                    start + A1_MICRO_BATCH_SIZE,\n                    n_tiles\n                )\n\n                x_raw = images[start:end]\n                y_raw = targets[start:end]\n\n                # Synchronized geometric augmentation:\n                # image + semantic mask + spine mask.\n\n                x, y = augment_and_normalize(\n                    x_raw,\n                    y_raw,\n                    mean=normalization_stats[\"mean\"],\n                    std=normalization_stats[\"std\"],\n                    training=True\n                )\n\n                x = x.to(\n                    device,\n                    non_blocking=True\n                )\n\n                y = y.to(\n                    device,\n                    dtype=torch.float32,\n                    non_blocking=True\n                )\n\n                # Mixed-precision forward.\n                with torch.autocast(\n                    device_type=\"cuda\",\n                    dtype=torch.float16,\n                    enabled=True\n                ):\n\n                    logits = model(x)\n\n                if not torch.isfinite(logits).all().item():\n\n                    raise RuntimeError(\n                        f\"Non-finite logits at epoch={epoch}, \"\n                        f\"step={step}, tiles={start}:{end}, \"\n                        f\"photos={batch['file_name']}\"\n                    )\n\n                losses = a1_loss_function(\n                    logits=logits.float(),\n                    targets=y,\n                    spine_pos_weight=A1_SPINE_POS_WEIGHT,\n                    lambda_spine=A1_LAMBDA_SPINE\n                )\n\n                loss = losses[\"total\"]\n\n                if not torch.isfinite(loss).item():\n\n                    raise RuntimeError(\n                        f\"Non-finite loss at epoch={epoch}, \"\n                        f\"step={step}, tiles={start}:{end}\"\n                    )\n\n                # Correctly weight the final microbatch too.\n                chunk_size = end - start\n\n                chunk_weight = (\n                    chunk_size / n_tiles\n                )\n\n                weighted_loss = (\n                    loss * chunk_weight\n                )\n\n                scaler.scale(\n                    weighted_loss\n                ).backward()\n\n                # Track loss values weighted by tile count.\n                for name in metric_names:\n\n                    value = losses[name].detach().item()\n\n                    batch_loss_values[name] += (\n                        value * chunk_size / n_tiles\n                    )\n\n                    epoch_sums[name] += (\n                        value * chunk_size\n                    )\n\n                total_tile_count += chunk_size\n\n                del x, y, logits, losses, loss, weighted_loss\n\n\n            # ------------------------------------------------\n            # 6. Unscale, clip, optimizer step\n            # ------------------------------------------------\n\n            scaler.unscale_(optimizer)\n\n            grad_norm = clip_grad_norm_(\n                model.parameters(),\n                max_norm=A1_GRADIENT_CLIP\n            )\n\n            norm_is_finite = torch.isfinite(\n                grad_norm\n            ).item()\n\n            old_scale = scaler.get_scale()\n\n            scaler.step(optimizer)\n\n            scaler.update()\n\n            new_scale = scaler.get_scale()\n\n            update_skipped = (\n                new_scale < old_scale\n            )\n\n            if update_skipped:\n\n                skipped_updates += 1\n                consecutive_skips += 1\n\n                print(\n                    f\"\\nAMP overflow: update skipped. \"\n                    f\"Scale {old_scale:g} -> {new_scale:g}\"\n                )\n\n                print(\n                    \"Photos:\",\n                    batch[\"file_name\"]\n                )\n\n                if consecutive_skips >= 5:\n\n                    raise RuntimeError(\n                        \"Five consecutive optimizer updates were skipped. \"\n                        \"Stop and investigate numerical instability.\"\n                    )\n\n            else:\n\n                if not norm_is_finite:\n\n                    raise RuntimeError(\n                        \"Gradient norm is non-finite, \"\n                        \"but GradScaler did not skip the update.\"\n                    )\n\n                successful_updates += 1\n\n                consecutive_skips = 0\n\n                gradient_norm_sum += grad_norm.item()\n                gradient_norm_count += 1\n\n            optimizer.zero_grad(set_to_none=True)\n\n\n            # ------------------------------------------------\n            # 7. Periodic progress\n            # ------------------------------------------------\n\n            if (step + 1) % 50 == 0:\n\n                print(\n                    f\"Step {step + 1}/{len(train_loader)} | \"\n                    f\"Loss={batch_loss_values['total']:.4f} | \"\n                    f\"Mask={batch_loss_values['mask_loss']:.4f} | \"\n                    f\"Spine={batch_loss_values['spine_loss']:.4f}\"\n                )\n\n\n        # ----------------------------------------------------\n        # 8. Epoch training statistics\n        # ----------------------------------------------------\n\n        if total_tile_count == 0:\n\n            raise RuntimeError(\n                \"No training tiles were processed.\"\n            )\n\n        train_metrics = {\n            name: epoch_sums[name] / total_tile_count\n            for name in metric_names\n        }\n\n        average_gradient_norm = (\n            gradient_norm_sum / gradient_norm_count\n            if gradient_norm_count > 0\n            else float(\"nan\")\n        )\n\n\n        # ----------------------------------------------------\n        # 9. Full-image validation every 3 epochs\n        # ----------------------------------------------------\n\n        validation_summary = None\n\n        validation_score = None\n\n        validation_photo_results = None\n\n        validation_annotation_results = None\n\n        lr_used = optimizer.param_groups[0][\"lr\"]\n\n        improved = False\n\n        if epoch % A1_VALIDATION_INTERVAL == 0:\n\n            print(\"\\nRunning full-image validation...\")\n\n            (\n                validation_summary,\n                validation_photo_results,\n                validation_annotation_results\n            ) = validate_a1(\n                model,\n                val_loader,\n                device,\n                threshold=0.5\n            )\n\n            validation_score = (\n                validation_summary[\"mean_photo_dice\"]\n            )\n\n            last_validation_summary = validation_summary\n\n            # ReduceLROnPlateau is stepped only when\n            # a new validation result is available.\n            scheduler.step(validation_score)\n\n            improved = (\n                validation_score > best_score\n            )\n\n            if improved:\n\n                best_score = validation_score\n\n                bad_validation_checks = 0\n\n                best_state = {\n\n                    \"run_id\": RUN_ID,\n\n                    \"epoch\": epoch,\n\n                    \"model_state_dict\": a1_cpu_state_dict(\n                        model\n                    ),\n\n                    \"best_val_dice\": best_score,\n\n                    \"validation_summary\": validation_summary,\n\n                    \"normalization_stats\": normalization_stats,\n\n                    \"target_statistics\": target_statistics,\n\n                    \"config\": A1_CONFIG\n\n                }\n\n                atomic_torch_save(\n                    best_state,\n                    A1_BEST_CHECKPOINT\n                )\n\n                print(\"\\nNew best A1 checkpoint saved.\")\n\n            else:\n\n                bad_validation_checks += 1\n\n            # Preserve all per-photo and per-annotator results.\n            a1_atomic_csv_save(\n                validation_photo_results,\n                CHECKPOINT_DIR\n                / f\"a1_validation_photos_epoch_{epoch:03d}.csv\"\n            )\n\n            a1_atomic_csv_save(\n                validation_annotation_results,\n                CHECKPOINT_DIR\n                / f\"a1_validation_annotations_epoch_{epoch:03d}.csv\"\n            )\n\n\n        # ----------------------------------------------------\n        # 10. Record epoch history\n        # ----------------------------------------------------\n\n        elapsed = time.time() - epoch_start\n\n        peak_memory_gb = (\n            torch.cuda.max_memory_allocated(device)\n            / 1024**3\n        )\n\n        record = {\n\n            \"epoch\": epoch,\n\n            \"train_total_loss\": train_metrics[\"total\"],\n\n            \"train_mask_loss\": train_metrics[\"mask_loss\"],\n\n            \"train_mask_bce\": train_metrics[\"mask_bce\"],\n\n            \"train_mask_dice\": train_metrics[\"mask_dice\"],\n\n            \"train_spine_loss\": train_metrics[\"spine_loss\"],\n\n            \"train_spine_bce\": train_metrics[\"spine_bce\"],\n\n            \"train_spine_dice\": train_metrics[\"spine_dice\"],\n\n            \"val_photo_dice\": validation_score,\n\n            \"val_photo_iou\": (\n                validation_summary[\"mean_photo_iou\"]\n                if validation_summary else None\n            ),\n\n            \"val_batch_dice\": (\n                validation_summary[\"mean_batch_dice\"]\n                if validation_summary else None\n            ),\n\n            \"val_batch_iou\": (\n                validation_summary[\"mean_batch_iou\"]\n                if validation_summary else None\n            ),\n\n            \"successful_updates\": successful_updates,\n\n            \"skipped_updates\": skipped_updates,\n\n            \"average_gradient_norm\": average_gradient_norm,\n\n            \"amp_scale\": scaler.get_scale(),\n\n            \"learning_rate_used\": lr_used,\n\n            \"learning_rate_next\": optimizer.param_groups[0][\"lr\"],\n\n            \"best_val_dice\": (\n                best_score\n                if np.isfinite(best_score)\n                else None\n            ),\n\n            \"bad_validation_checks\": bad_validation_checks,\n\n            \"elapsed_seconds\": elapsed,\n\n            \"peak_gpu_memory_gb\": peak_memory_gb\n\n        }\n\n        history.append(record)\n\n        history_df = pd.DataFrame(history)\n\n        a1_atomic_csv_save(\n            history_df,\n            A1_HISTORY_FILE\n        )\n\n\n        # ----------------------------------------------------\n        # 11. Atomic last checkpoint every epoch\n        # ----------------------------------------------------\n\n        last_state = a1_make_checkpoint(\n\n            epoch=epoch,\n\n            model=model,\n\n            optimizer=optimizer,\n\n            scheduler=scheduler,\n\n            scaler=scaler,\n\n            best_score=best_score,\n\n            bad_validation_checks=bad_validation_checks,\n\n            consecutive_skips=consecutive_skips,\n\n            history=history,\n\n            train_loader=train_loader,\n\n            last_validation_summary=last_validation_summary\n\n        )\n\n        atomic_torch_save(\n            last_state,\n            A1_LAST_CHECKPOINT\n        )\n\n\n        # ----------------------------------------------------\n        # 12. Recovery bundle every validation epoch\n        # ----------------------------------------------------\n\n        if epoch % A1_VALIDATION_INTERVAL == 0:\n\n            a1_save_recovery_bundle(epoch)\n\n\n        # ----------------------------------------------------\n        # 13. Epoch summary\n        # ----------------------------------------------------\n\n        print(\"\\n\" + \"-\" * 65)\n        print(f\"A1 EPOCH {epoch} SUMMARY\")\n        print(\"-\" * 65)\n\n        print(f\"Training total loss: {train_metrics['total']:.5f}\")\n\n        print(f\"  Mask loss:  {train_metrics['mask_loss']:.5f}\")\n\n        print(f\"    BCE:      {train_metrics['mask_bce']:.5f}\")\n\n        print(f\"    Dice:     {train_metrics['mask_dice']:.5f}\")\n\n        print(f\"  Spine loss: {train_metrics['spine_loss']:.5f}\")\n\n        print(f\"    BCE:      {train_metrics['spine_bce']:.5f}\")\n\n        print(f\"    Dice:     {train_metrics['spine_dice']:.5f}\")\n\n        if validation_summary is not None:\n\n            print(\n                \"Validation photo Dice:\",\n                f\"{validation_summary['mean_photo_dice']:.5f}\"\n            )\n\n            print(\n                \"Validation photo IoU:\",\n                f\"{validation_summary['mean_photo_iou']:.5f}\"\n            )\n\n            print(\n                \"Validation annotation sets:\",\n                validation_summary[\"n_annotation_sets\"]\n            )\n\n        print(\"Successful updates:\", successful_updates)\n\n        print(\"Skipped updates:\", skipped_updates)\n\n        print(\"AMP scale:\", scaler.get_scale())\n\n        print(\"Average gradient norm:\", average_gradient_norm)\n\n        print(\"Best validation Dice:\", best_score)\n\n        print(\n            \"Learning rate:\",\n            optimizer.param_groups[0][\"lr\"]\n        )\n\n        print(\n            \"Peak GPU memory:\",\n            round(peak_memory_gb, 2),\n            \"GB\"\n        )\n\n        print(\n            \"Elapsed:\",\n            round(elapsed / 60, 2),\n            \"minutes\"\n        )\n\n        print(\"Last checkpoint saved:\", A1_LAST_CHECKPOINT)\n\n\n        # ----------------------------------------------------\n        # 14. Early stopping\n        # ----------------------------------------------------\n\n        if (\n            epoch % A1_VALIDATION_INTERVAL == 0\n            and bad_validation_checks\n            >= A1_EARLY_STOPPING_CHECKS\n        ):\n\n            print(\n                \"\\nA1 early stopping triggered after \"\n                f\"{bad_validation_checks} non-improving \"\n                \"validation checks.\"\n            )\n\n            break\n\n\n    print(\"\\n\" + \"=\" * 65)\n    print(\"A1 TRAINING FINISHED\")\n    print(\"=\" * 65)\n\n    print(\"Last checkpoint:\", A1_LAST_CHECKPOINT)\n    print(\"Best checkpoint:\", A1_BEST_CHECKPOINT)\n    print(\"History:\", A1_HISTORY_FILE)\n\n    return pd.DataFrame(history)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Pilot Test\n\nWe should not commit immediately to all 24 epochs. The 3-epoch pilot gives us a complete cycle: training, full-image validation, checkpointing and recovery-bundle creation. We then eventually inspect every iterations and then increase the total number of epochs ","metadata":{}},{"cell_type":"code","source":"\n# ============================================================\n# A1 AUTO-RECOVERY + AUTOMATIC RESUME\n#\n# Detects:\n#   1. Existing A1 last checkpoints\n#   2. Downloaded A1 recovery ZIP bundles\n#\n# Selects the newest valid checkpoint for this RUN_ID.\n# Restores it into RUN_ROOT if necessary.\n# Resumes from checkpoint_epoch + 1.\n#\n# Expected recovery: epoch 3 -> resume at epoch 4\n# ============================================================\n\nimport os\nimport io\nimport json\nimport shutil\nimport tempfile\nimport zipfile\n\nfrom pathlib import Path, PurePosixPath\n\nimport torch\nimport pandas as pd\nimport numpy as np\n\n\n# ------------------------------------------------------------\n# 1. SETTINGS\n# ------------------------------------------------------------\n\nMAX_EPOCHS = 24\nEXPECTED_MINIMUM_EPOCH = 3\n\n# Search these locations for uploaded recovery files.\nSEARCH_ROOTS = [\n    Path(\"/kaggle/input\"),\n    Path(\"/kaggle/input/epoch-3-run\"),  # <- your recovery dataset\n    Path(\"/kaggle/working\"),\n    Path(\"/mnt/data\"),\n    Path.cwd()\n]\n\n# Optional: add another directory here if your ZIP is stored\n# somewhere outside the standard Kaggle locations.\nEXTRA_RECOVERY_DIR = None\n\nif EXTRA_RECOVERY_DIR is not None:\n    SEARCH_ROOTS.append(Path(EXTRA_RECOVERY_DIR))\n\nRUN_ROOT = Path(RUN_ROOT)\n\nCHECKPOINT_DIR = RUN_ROOT / \"checkpoints\"\nLOG_DIR = RUN_ROOT / \"logs\"\n\nA1_LAST_CHECKPOINT = CHECKPOINT_DIR / \"a1_last.pt\"\nA1_BEST_CHECKPOINT = CHECKPOINT_DIR / \"a1_best.pt\"\nA1_HISTORY_FILE = LOG_DIR / \"a1_history.csv\"\n\nRUN_ROOT.mkdir(parents=True, exist_ok=True)\nCHECKPOINT_DIR.mkdir(parents=True, exist_ok=True)\nLOG_DIR.mkdir(parents=True, exist_ok=True)\n\nassert RUN_ID == \"A1_SpineAux_ResNet34_Fold0_Seed2026\"\nassert MAX_EPOCHS >= EXPECTED_MINIMUM_EPOCH\nassert \"train_a1\" in globals()\nassert \"a1_model\" in globals()\n\n\n# ------------------------------------------------------------\n# 2. CHECKPOINT VALIDATION\n# ------------------------------------------------------------\n\nREQUIRED_CHECKPOINT_KEYS = {\n    \"run_id\",\n    \"epoch\",\n    \"model_state_dict\",\n    \"optimizer_state_dict\",\n    \"scheduler_state_dict\",\n    \"scaler_state_dict\",\n    \"best_score\",\n    \"bad_validation_checks\",\n    \"consecutive_skips\",\n    \"history\",\n    \"last_validation_summary\",\n    \"loader_generator_state\",\n    \"torch_rng_state\",\n    \"cuda_rng_states\",\n    \"numpy_rng_state\",\n    \"python_rng_state\",\n    \"normalization_stats\",\n    \"target_statistics\",\n    \"config\"\n}\n\n\ndef a1_load_checkpoint(path):\n\n    path = Path(path)\n\n    try:\n        checkpoint = torch.load(\n            path,\n            map_location=\"cpu\",\n            weights_only=False\n        )\n    except TypeError:\n        checkpoint = torch.load(\n            path,\n            map_location=\"cpu\"\n        )\n\n    if not isinstance(checkpoint, dict):\n        raise ValueError(\"Checkpoint is not a dictionary.\")\n\n    missing = (\n        REQUIRED_CHECKPOINT_KEYS\n        - set(checkpoint.keys())\n    )\n\n    if missing:\n        raise ValueError(\n            f\"Incomplete checkpoint. Missing: {sorted(missing)}\"\n        )\n\n    if checkpoint[\"run_id\"] != RUN_ID:\n        raise ValueError(\n            f\"Wrong run ID: {checkpoint['run_id']}\"\n        )\n\n    if not isinstance(checkpoint[\"epoch\"], int):\n        raise ValueError(\"Invalid checkpoint epoch.\")\n\n    return checkpoint\n\n\ndef a1_validate_checkpoint_config(checkpoint):\n\n    saved_config = checkpoint[\"config\"]\n\n    if saved_config.get(\"run_id\") != RUN_ID:\n        raise ValueError(\"Saved experiment configuration has a different run ID.\")\n\n    # These settings must remain identical when resuming.\n    critical_keys = [\n        \"seed\",\n        \"architecture\",\n        \"encoder\",\n        \"input_channels\",\n        \"output_channels\",\n        \"tile_size\",\n        \"tile_stride\",\n        \"training_folds\",\n        \"validation_fold\",\n        \"lambda_spine\",\n        \"spine_pos_weight\",\n        \"learning_rate\",\n        \"weight_decay\",\n        \"photo_batch_size\",\n        \"tile_micro_batch\",\n        \"normalization_mean\",\n        \"normalization_std\"\n    ]\n\n    for key in critical_keys:\n\n        if key not in saved_config or key not in A1_CONFIG:\n            continue\n\n        saved_value = saved_config[key]\n        current_value = A1_CONFIG[key]\n\n        if isinstance(saved_value, (int, float)) and isinstance(\n            current_value, (int, float)\n        ):\n\n            matches = np.isclose(\n                saved_value,\n                current_value\n            )\n\n        else:\n\n            matches = saved_value == current_value\n\n        if not matches:\n            raise ValueError(\n                f\"Experiment mismatch for '{key}': \"\n                f\"checkpoint={saved_value}, current={current_value}\"\n            )\n\n    saved_norm = checkpoint[\"normalization_stats\"]\n\n    assert np.isclose(\n        saved_norm[\"mean\"],\n        normalization_stats[\"mean\"]\n    )\n\n    assert np.isclose(\n        saved_norm[\"std\"],\n        normalization_stats[\"std\"]\n    )\n\n    saved_target_stats = checkpoint[\"target_statistics\"]\n\n    assert np.isclose(\n        saved_target_stats[\"spine_pos_weight\"],\n        target_statistics[\"spine_pos_weight\"]\n    )\n\n\n# ------------------------------------------------------------\n# 3. DISCOVER EXISTING CHECKPOINT FILES\n# ------------------------------------------------------------\n\ncandidates = []\nrejected = []\nseen_paths = set()\n\nprint(\"=\" * 70)\nprint(\"A1 AUTOMATIC RECOVERY: SEARCHING FOR EXISTING RUNS\")\nprint(\"=\" * 70)\n\n\ndef a1_register_direct_checkpoint(checkpoint_path):\n\n    checkpoint_path = Path(checkpoint_path)\n\n    try:\n\n        checkpoint = a1_load_checkpoint(checkpoint_path)\n\n        a1_validate_checkpoint_config(checkpoint)\n\n        # Checkpoint is expected inside a \"checkpoints\" directory.\n        if checkpoint_path.parent.name != \"checkpoints\":\n            raise ValueError(\"Unexpected checkpoint directory structure.\")\n\n        source_root = checkpoint_path.parent.parent\n\n        required_files = [\n            source_root / \"checkpoints\" / \"a1_best.pt\",\n            source_root / \"logs\" / \"a1_history.csv\"\n        ]\n\n        complete = all(p.exists() for p in required_files)\n\n        candidates.append({\n            \"epoch\": checkpoint[\"epoch\"],\n            \"kind\": \"direct\",\n            \"path\": checkpoint_path,\n            \"source_root\": source_root,\n            \"checkpoint\": checkpoint,\n            \"complete\": complete\n        })\n\n        print(\n            f\"Found checkpoint: {checkpoint_path} \"\n            f\"(epoch {checkpoint['epoch']})\"\n        )\n\n    except Exception as exc:\n\n        rejected.append(\n            (str(checkpoint_path), str(exc))\n        )\n\n\nfor root in SEARCH_ROOTS:\n\n    if not root.exists():\n        continue\n\n    for checkpoint_path in root.rglob(\"a1_last.pt\"):\n\n        resolved = str(checkpoint_path.resolve())\n\n        if resolved in seen_paths:\n            continue\n\n        seen_paths.add(resolved)\n\n        a1_register_direct_checkpoint(\n            checkpoint_path\n        )\n\n\n# ------------------------------------------------------------\n# 4. DISCOVER AND INSPECT RECOVERY ZIP FILES\n# ------------------------------------------------------------\n\ndef a1_inspect_recovery_zip(zip_path):\n\n    zip_path = Path(zip_path)\n\n    with zipfile.ZipFile(zip_path, \"r\") as archive:\n\n        names = archive.namelist()\n\n        # Find the full-resume checkpoint within the ZIP.\n        last_members = [\n            name for name in names\n            if (\n                not name.endswith(\"/\")\n                and PurePosixPath(name).name == \"a1_last.pt\"\n                and \"checkpoints\" in PurePosixPath(name).parts\n            )\n        ]\n\n        if not last_members:\n            return\n\n        if len(last_members) != 1:\n            raise ValueError(\n                \"ZIP contains multiple a1_last.pt checkpoints.\"\n            )\n\n        last_member = last_members[0]\n\n        parts = PurePosixPath(last_member).parts\n\n        checkpoint_position = parts.index(\"checkpoints\")\n\n        archive_prefix = parts[:checkpoint_position]\n\n        # Convert archive members to paths relative to RUN_ROOT.\n        relative_members = set()\n\n        for name in names:\n\n            if name.endswith(\"/\"):\n                continue\n\n            member_path = PurePosixPath(name)\n\n            if (\n                member_path.is_absolute()\n                or \"..\" in member_path.parts\n                or \"\\\\\" in name\n            ):\n                raise ValueError(\n                    f\"Unsafe ZIP member: {name}\"\n                )\n\n            if member_path.parts[:len(archive_prefix)] != archive_prefix:\n                continue\n\n            relative = PurePosixPath(\n                *member_path.parts[len(archive_prefix):]\n            )\n\n            relative_members.add(str(relative))\n\n        required_bundle_files = {\n            \"checkpoints/a1_last.pt\",\n            \"checkpoints/a1_best.pt\",\n            \"logs/a1_history.csv\",\n            \"experiment_config.json\",\n            \"target_statistics.json\"\n        }\n\n        missing = (\n            required_bundle_files - relative_members\n        )\n\n        if missing:\n            raise ValueError(\n                f\"Incomplete recovery ZIP. Missing: {sorted(missing)}\"\n            )\n\n        # Verify ZIP integrity before accepting it.\n        bad_member = archive.testzip()\n\n        if bad_member is not None:\n            raise ValueError(\n                f\"Corrupt ZIP member: {bad_member}\"\n            )\n\n        # Read the checkpoint to a temporary disk file.\n        # This avoids loading the 300+ MiB ZIP member into RAM.\n        temp_checkpoint_path = None\n\n        try:\n\n            with archive.open(last_member) as source:\n\n                with tempfile.NamedTemporaryFile(\n                    suffix=\".pt\",\n                    delete=False\n                ) as temporary:\n\n                    temp_checkpoint_path = Path(temporary.name)\n\n                    shutil.copyfileobj(\n                        source,\n                        temporary\n                    )\n\n            checkpoint = a1_load_checkpoint(\n                temp_checkpoint_path\n            )\n\n            a1_validate_checkpoint_config(checkpoint)\n\n        finally:\n\n            if (\n                temp_checkpoint_path is not None\n                and temp_checkpoint_path.exists()\n            ):\n                temp_checkpoint_path.unlink()\n\n        candidates.append({\n\n            \"epoch\": checkpoint[\"epoch\"],\n\n            \"kind\": \"zip\",\n\n            \"path\": zip_path,\n\n            \"last_member\": last_member,\n\n            \"archive_prefix\": archive_prefix,\n\n            \"checkpoint\": checkpoint,\n\n            \"complete\": True\n\n        })\n\n        print(\n            f\"Found recovery ZIP: {zip_path} \"\n            f\"(epoch {checkpoint['epoch']})\"\n        )\n\n\nzip_paths = set()\n\nfor root in SEARCH_ROOTS:\n\n    if not root.exists():\n        continue\n\n    for zip_path in root.rglob(\"*.zip\"):\n\n        zip_paths.add(zip_path.resolve())\n        \nprint(\"\\nSearching ZIP files...\\n\")\n\nfor z in sorted(zip_paths):\n    print(z)\n\nprint(\"\\n\")\n\nfor zip_path in sorted(zip_paths):\n\n    try:\n\n        a1_inspect_recovery_zip(zip_path)\n\n    except Exception as exc:\n\n        rejected.append(\n            (str(zip_path), str(exc))\n        )\n\n\n# ------------------------------------------------------------\n# 5. SELECT THE NEWEST VALID CHECKPOINT\n# ------------------------------------------------------------\n\nif not candidates:\n\n    print(\"\\nNo valid A1 checkpoint or recovery ZIP found.\")\n\n    if rejected:\n\n        print(\"\\nRejected candidates:\")\n        for path, reason in rejected[:10]:\n            print(\"-\", path, \":\", reason)\n\n    raise FileNotFoundError(\n        \"\\nA1 recovery could not proceed. \"\n        \"Add the epoch-3 recovery ZIP to Kaggle Notebook Inputs \"\n        \"and rerun this cell. No fresh training run was started.\"\n    )\n\n\n# Prefer the newest epoch.\n# If epochs tie, prefer a complete direct run directory,\n# then a recovery ZIP, then an incomplete direct checkpoint.\n\ndef a1_candidate_priority(candidate):\n\n    if candidate[\"kind\"] == \"direct\" and candidate[\"complete\"]:\n        return 3\n\n    if candidate[\"kind\"] == \"zip\":\n        return 2\n\n    return 1\n\n\ncandidates.sort(\n    key=lambda item: (\n        item[\"epoch\"],\n        a1_candidate_priority(item)\n    ),\n    reverse=True\n)\n\nselected = candidates[0]\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"SELECTED A1 RECOVERY\")\nprint(\"=\" * 70)\n\nprint(\"Source:\", selected[\"path\"])\nprint(\"Checkpoint epoch:\", selected[\"epoch\"])\nprint(\"Run ID:\", RUN_ID)\n\n\n# ------------------------------------------------------------\n# 6. RESTORE THE SELECTED CHECKPOINT/BUNDLE\n# ------------------------------------------------------------\n\nif selected[\"kind\"] == \"zip\":\n\n    zip_path = selected[\"path\"]\n\n    archive_prefix = selected[\"archive_prefix\"]\n\n    print(\"\\nRestoring recovery ZIP into:\")\n    print(RUN_ROOT)\n\n    with tempfile.TemporaryDirectory(\n        prefix=\"a1_restore_\",\n        dir=str(RUN_ROOT.parent)\n    ) as staging_directory:\n\n        staging_directory = Path(staging_directory)\n\n        with zipfile.ZipFile(zip_path, \"r\") as archive:\n\n            for info in archive.infolist():\n\n                if info.is_dir():\n                    continue\n\n                member_path = PurePosixPath(info.filename)\n\n                if (\n                    member_path.is_absolute()\n                    or \"..\" in member_path.parts\n                    or \"\\\\\" in info.filename\n                ):\n                    raise ValueError(\n                        f\"Unsafe archive member: {info.filename}\"\n                    )\n\n                if (\n                    member_path.parts[:len(archive_prefix)]\n                    != archive_prefix\n                ):\n                    continue\n\n                relative_parts = member_path.parts[\n                    len(archive_prefix):\n                ]\n\n                if not relative_parts:\n                    continue\n\n                relative_path = Path(*relative_parts)\n\n                staged_file = staging_directory / relative_path\n\n                staged_file.parent.mkdir(\n                    parents=True,\n                    exist_ok=True\n                )\n\n                with archive.open(info) as source:\n                    with open(staged_file, \"wb\") as destination:\n                        shutil.copyfileobj(\n                            source,\n                            destination\n                        )\n\n        # Validate staged recovery before installing it.\n        staged_last = (\n            staging_directory\n            / \"checkpoints\"\n            / \"a1_last.pt\"\n        )\n\n        staged_checkpoint = a1_load_checkpoint(\n            staged_last\n        )\n\n        if staged_checkpoint[\"epoch\"] != selected[\"epoch\"]:\n            raise ValueError(\n                \"Staged checkpoint epoch mismatch.\"\n            )\n\n        # Atomically install the recovered files.\n        for source_file in staging_directory.rglob(\"*\"):\n\n            if not source_file.is_file():\n                continue\n\n            relative = source_file.relative_to(\n                staging_directory\n            )\n\n            destination = RUN_ROOT / relative\n\n            destination.parent.mkdir(\n                parents=True,\n                exist_ok=True\n            )\n\n            temporary_destination = destination.with_name(\n                destination.name + \".restore.tmp\"\n            )\n\n            shutil.copy2(\n                source_file,\n                temporary_destination\n            )\n\n            os.replace(\n                temporary_destination,\n                destination\n            )\n\n    print(\"Recovery ZIP restored successfully.\")\n\n\nelif selected[\"kind\"] == \"direct\":\n\n    source_root = selected[\"source_root\"]\n\n    if source_root.resolve() != RUN_ROOT.resolve():\n\n        print(\"\\nCopying existing checkpoint run into RUN_ROOT.\")\n\n        for relative in [\n            Path(\"checkpoints/a1_last.pt\"),\n            Path(\"checkpoints/a1_best.pt\"),\n            Path(\"logs/a1_history.csv\"),\n            Path(\"experiment_config.json\"),\n            Path(\"target_statistics.json\")\n        ]:\n\n            source_file = source_root / relative\n\n            if not source_file.exists():\n                continue\n\n            destination = RUN_ROOT / relative\n\n            destination.parent.mkdir(\n                parents=True,\n                exist_ok=True\n            )\n\n            temporary_destination = destination.with_name(\n                destination.name + \".restore.tmp\"\n            )\n\n            shutil.copy2(\n                source_file,\n                temporary_destination\n            )\n\n            os.replace(\n                temporary_destination,\n                destination\n            )\n\n\n# ------------------------------------------------------------\n# 7. FINAL RESTORE VALIDATION\n# ------------------------------------------------------------\n\nassert A1_LAST_CHECKPOINT.exists()\nassert A1_BEST_CHECKPOINT.exists()\nassert A1_HISTORY_FILE.exists()\n\nrestored_checkpoint = a1_load_checkpoint(\n    A1_LAST_CHECKPOINT\n)\n\na1_validate_checkpoint_config(\n    restored_checkpoint\n)\n\nrestored_epoch = restored_checkpoint[\"epoch\"]\n\nassert restored_epoch >= EXPECTED_MINIMUM_EPOCH\n\nassert restored_epoch < MAX_EPOCHS or restored_epoch == MAX_EPOCHS\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"A1 RESTORE VALIDATION: PASSED\")\nprint(\"=\" * 70)\n\nprint(\"Recovered epoch:\", restored_epoch)\nprint(\"Next epoch:\", restored_epoch + 1)\nprint(\"Target maximum epoch:\", MAX_EPOCHS)\nprint(\"Best validation Dice:\", restored_checkpoint[\"best_score\"])\n\nprint(\n    \"History rows:\",\n    len(restored_checkpoint[\"history\"])\n)\n\nprint(\"Last checkpoint:\", A1_LAST_CHECKPOINT)\nprint(\"Best checkpoint:\", A1_BEST_CHECKPOINT)\n\n\n# ------------------------------------------------------------\n# 8. AUTOMATIC RESUME\n# ------------------------------------------------------------\n\nif restored_epoch >= MAX_EPOCHS:\n\n    print(\n        f\"\\nA1 already reached epoch {restored_epoch}. \"\n        \"No additional training is necessary.\"\n    )\n\n    a1_history = pd.read_csv(\n        A1_HISTORY_FILE\n    )\n\nelse:\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\n        f\"RESUMING A1: EPOCH {restored_epoch + 1} \"\n        f\"THROUGH EPOCH {MAX_EPOCHS}\"\n    )\n    print(\"=\" * 70)\n\n    a1_history = train_a1(\n        model=a1_model,\n        train_loader=a1_train_loader,\n        val_loader=a1_val_loader,\n        max_epochs=MAX_EPOCHS,\n        resume=True\n    )\n\n\ndisplay(a1_history)","metadata":{"trusted":true,"scrolled":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Protect the epoch-N recovery point\nBefore continuing, verify that both checkpoints and the recovery bundle exist and that the ZIP is readable.","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# A1.18: VERIFY LATEST RECOVERY ARTIFACTS\n# ============================================================\n\nimport re\nimport zipfile\nimport torch\nimport pandas as pd\n\n# ------------------------------------------------------------\n# 1. Get the actual completed epoch from the checkpoint\n# ------------------------------------------------------------\n\nassert A1_LAST_CHECKPOINT.exists()\n\nlatest_checkpoint = torch.load(\n    A1_LAST_CHECKPOINT,\n    map_location=\"cpu\",\n    weights_only=False\n)\n\nassert latest_checkpoint[\"run_id\"] == RUN_ID\n\ncheckpoint_epoch = int(latest_checkpoint[\"epoch\"])\n\nprint(\"Latest completed epoch:\", checkpoint_epoch)\n\n\n# ------------------------------------------------------------\n# 2. Verify the core artifacts\n# ------------------------------------------------------------\n\nrequired_files = [\n    A1_LAST_CHECKPOINT,\n    A1_BEST_CHECKPOINT,\n    A1_HISTORY_FILE\n]\n\nfor path in required_files:\n\n    assert path.exists(), f\"Missing artifact: {path}\"\n\n    size_bytes = path.stat().st_size\n\n    print(\n        f\"{path.name}: \"\n        f\"{size_bytes:,} bytes \"\n        f\"({size_bytes / 1024**2:.2f} MiB)\"\n    )\n\n\n# ------------------------------------------------------------\n# 3. Verify history\n# ------------------------------------------------------------\n\na1_saved_history = pd.read_csv(A1_HISTORY_FILE)\n\nassert not a1_saved_history.empty\n\nassert int(a1_saved_history[\"epoch\"].max()) == checkpoint_epoch\n\nprint(\"\\nHistory rows:\", len(a1_saved_history))\nprint(\"History reaches epoch:\", checkpoint_epoch)\n\n\n# ------------------------------------------------------------\n# 4. Discover recovery bundles\n# ------------------------------------------------------------\n\nrecovery_bundles = []\n\nfor path in A1_RECOVERY_DIR.glob(\"a1_recovery_epoch_*.zip\"):\n\n    match = re.fullmatch(\n        r\"a1_recovery_epoch_(\\d{3})\",\n        path.stem\n    )\n\n    if match:\n\n        bundle_epoch = int(match.group(1))\n\n        if bundle_epoch <= checkpoint_epoch:\n\n            recovery_bundles.append(\n                (bundle_epoch, path)\n            )\n\nassert recovery_bundles, \"No valid recovery ZIP found.\"\n\nbundle_epoch, epoch_bundle = max(\n    recovery_bundles,\n    key=lambda item: item[0]\n)\n\nprint(\"\\nLatest recovery bundle:\", epoch_bundle.name)\nprint(\"Bundle epoch:\", bundle_epoch)\n\n\n# ------------------------------------------------------------\n# 5. ZIP integrity check\n# ------------------------------------------------------------\n\nwith zipfile.ZipFile(epoch_bundle, \"r\") as archive:\n\n    corrupted_file = archive.testzip()\n\n    assert corrupted_file is None, (\n        f\"Corrupted ZIP member: {corrupted_file}\"\n    )\n\n    members = set(archive.namelist())\n\n    required_members = {\n        \"checkpoints/a1_last.pt\",\n        \"checkpoints/a1_best.pt\",\n        \"logs/a1_history.csv\",\n        \"experiment_config.json\",\n        \"target_statistics.json\"\n    }\n\n    missing_members = required_members - members\n\n    assert not missing_members, (\n        f\"Missing ZIP contents: {missing_members}\"\n    )\n\n    print(\"\\nRecovery bundle contents:\")\n    for name in sorted(members):\n        print(\" \", name)\n\n\nprint(\"\\nA1.18 RECOVERY ARTIFACTS: PASSED\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### Zip Download for n-Epochs","metadata":{}},{"cell_type":"code","source":"from IPython.display import display, FileLink\n\ndisplay(FileLink(\n    \"/kaggle/working/solar_filament_experiments/A1_SpineAux_ResNet34_Fold0_Seed2026/recovery_bundles/a1_recovery_epoch_024.zip\"\n))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Inspect the validation results\nThis will expose the metric distributions and any differences between photo-level and annotation-level performance.","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# A1.19: LATEST VALIDATION DIAGNOSTICS\n# ============================================================\n\nimport re\nimport pandas as pd\nimport numpy as np\n\n\ndef discover_validation_files(directory, prefix):\n\n    results = {}\n\n    for path in Path(directory).glob(f\"{prefix}_epoch_*.csv\"):\n\n        match = re.fullmatch(\n            rf\"{re.escape(prefix)}_epoch_(\\d{{3}})\",\n            path.stem\n        )\n\n        if match:\n\n            results[int(match.group(1))] = path\n\n    return results\n\n\nphoto_files = discover_validation_files(\n    CHECKPOINT_DIR,\n    \"a1_validation_photos\"\n)\n\nannotation_files = discover_validation_files(\n    CHECKPOINT_DIR,\n    \"a1_validation_annotations\"\n)\n\ncommon_epochs = (\n    set(photo_files)\n    & set(annotation_files)\n)\n\nvalid_epochs = [\n    e for e in common_epochs\n    if e <= checkpoint_epoch\n]\n\nassert valid_epochs, \"No matching validation CSV files found.\"\n\nvalidation_epoch = max(valid_epochs)\n\nprint(\"Checkpoint epoch:\", checkpoint_epoch)\nprint(\"Latest validation epoch:\", validation_epoch)\n\n\n# ------------------------------------------------------------\n# Load the corresponding validation results\n# ------------------------------------------------------------\n\na1_val_photo_results_df = pd.read_csv(\n    photo_files[validation_epoch]\n)\n\na1_val_annotation_results_df = pd.read_csv(\n    annotation_files[validation_epoch]\n)\n\n\n# ------------------------------------------------------------\n# Photo-level analysis\n# ------------------------------------------------------------\n\nprint(\"\\nPHOTO-LEVEL VALIDATION\")\nprint(\"Shape:\", a1_val_photo_results_df.shape)\nprint(\"Columns:\", a1_val_photo_results_df.columns.tolist())\n\ndisplay(\n    a1_val_photo_results_df\n    .select_dtypes(include=np.number)\n    .describe()\n    .T\n)\n\n\n# ------------------------------------------------------------\n# Annotation-level analysis\n# ------------------------------------------------------------\n\nprint(\"\\nANNOTATION-LEVEL VALIDATION\")\nprint(\"Shape:\", a1_val_annotation_results_df.shape)\nprint(\"Columns:\", a1_val_annotation_results_df.columns.tolist())\n\ndisplay(\n    a1_val_annotation_results_df\n    .select_dtypes(include=np.number)\n    .describe()\n    .T\n)\n\n\n# ------------------------------------------------------------\n# Compare all validation epochs\n# ------------------------------------------------------------\n\nprint(\"\\nVALIDATION HISTORY\")\n\nvalidation_history = a1_saved_history[\n    a1_saved_history[\"val_photo_dice\"].notna()\n][[\n    \"epoch\",\n    \"val_photo_dice\",\n    \"val_photo_iou\",\n    \"best_val_dice\",\n    \"learning_rate_used\",\n    \"learning_rate_next\",\n    \"bad_validation_checks\"\n]]\n\ndisplay(validation_history.reset_index(drop=True))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Visual Inspection","metadata":{}},{"cell_type":"code","source":"import pandas as pd\nimport matplotlib.pyplot as plt\n\nhistory_path = (\n    \"/kaggle/working/solar_filament_experiments/\"\n    \"A1_SpineAux_ResNet34_Fold0_Seed2026/logs/a1_history.csv\"\n)\n\n# Load history\ndf = pd.read_csv(history_path)\n\n# Check column names\nprint(df.columns.tolist())\n\n# Display dataframe shape\nprint(\"Shape:\", df.shape)\n\n# -----------------------------------------------------------------------------\n# Plot Loss & Validation Metrics\n# -----------------------------------------------------------------------------\n\nepochs = df[\"epoch\"]\n\nfig, axes = plt.subplots(1, 2, figsize=(15, 5))\n\n# Training losses\naxes[0].plot(\n    epochs,\n    df[\"train_total_loss\"],\n    marker=\"o\",\n    linewidth=2,\n    label=\"Total Loss\"\n)\n\naxes[0].plot(\n    epochs,\n    df[\"train_mask_loss\"],\n    marker=\"s\",\n    linewidth=2,\n    label=\"Mask Loss\"\n)\n\naxes[0].plot(\n    epochs,\n    df[\"train_spine_loss\"],\n    marker=\"^\",\n    linewidth=2,\n    label=\"Spine Loss\"\n)\n\naxes[0].set_title(\"A1 Training Loss\")\naxes[0].set_xlabel(\"Epoch\")\naxes[0].set_ylabel(\"Loss\")\naxes[0].grid(True, alpha=0.3)\naxes[0].legend()\n\n# Validation metrics\nif \"val_photo_dice\" in df.columns:\n    axes[1].plot(\n        epochs,\n        df[\"val_photo_dice\"],\n        marker=\"o\",\n        linewidth=2,\n        label=\"Dice\"\n    )\n\nif \"val_photo_iou\" in df.columns:\n    axes[1].plot(\n        epochs,\n        df[\"val_photo_iou\"],\n        marker=\"s\",\n        linewidth=2,\n        label=\"IoU\"\n    )\n\naxes[1].set_title(\"A1 Validation Metrics\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].set_ylabel(\"Score\")\naxes[1].set_ylim(0, 1)\naxes[1].grid(True, alpha=0.3)\naxes[1].legend()\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Observations\n* After 6th epoch we still observe that the Training loss continues to decrease, thus we continue with the epochs for next runs\n\n* The training history confirms that the model continued learning through the run, with its lowest validation performance around epochs 6–9 and its best result at epoch 24\n\n* The optimization worked. The total loss dropped from approximately 1.31 to 0.32. Both the filament and spine objectives improved substantially, then stabilized. The final learning-rate reductions were also accompanied by stable training rather than numerical failure.\n\n* There is no compelling reason to train for another 24 epochs now. Validation has improved at the last checkpoint, but we have only eight validation measurements. More epochs would not answer the\n\n   **most important question: whether the predicted structures correspond to individual filaments.**\n\n<div style= 'red'> There are 3 caveats </div>\n\n* The final photo-level Dice standard deviation is 0.165, with a minimum of zero. The model has a difficult tail of observations even though its central performance is respectable.\n\n* Mean predicted foreground area is close to mean ground-truth area: approximately 14,461 versus 14,625 pixels per annotation record. That argues against a gross global foreground-area bias, but does not prove correct localization or instance identity.\n\n* A0's historical best Dice was 0.6510 and IoU 0.5018. A1's values are slightly lower. Because A0's checkpoint is lost and the runs were not controlled paired experiments, this is neither proof that A1 regressed nor proof that the spine head helped.\n\n**Therefore, the defensible A1 conclusion is: a ResNet34 U-Net with auxiliary spine supervision can learn semantic filament masks on the chosen holdout, reaching mean photo Dice 0.6478 and IoU 0.4980. Its effect on topology and instance quality has not yet been established.**\n\n---\n\nThe challenge originally emphasized pixel-level segmentation, but its evaluation was updated to Panoptic Quality (PQ). Its rubric assigns 70% to quantitative evaluation and 30% to pipeline quality and morphology. It explicitly considers the distributions of Dice and IoU, and one-to-many and many-to-one ground-truth/prediction relationships. \n\nThe official PQ calculation matches individual predicted and annotated instances only when their IoU is greater than 0.5:\n$$\nPQ = \\frac{\\sum_{(g,p)\\in TP} IoU(g,p)}\n{TP + 0.5FP + 0.5FN}\n$$\n\nThis rewards two things simultaneously:\n- Segmentation quality: how accurately each matched filament is outlined.\n- Recognition quality: whether each filament was found once, without missing it, splitting it into fragments or merging it with another filament.","metadata":{}},{"cell_type":"markdown","source":"**A1 currently produces two independent outputs:**\n- Channel 0: semantic filament probability.\n- Channel 1: auxiliary spine probability.\nThat is a useful multi-task model, but it is not yet a Panoptic U-Net. It has no explicit instance identity, centre heatmap, offset field, embedding or instance-selection mechanism.\n\nThe spine channel can guide continuity and instance construction, but we have not yet shown that it can distinguish one filament from another.\n\n**With A2 - the distinction that we must investigate**\n\n* Semantic output - Which pixels look like filament?\n* Instance output - Which pixels belong to filament 1, filament 2, filament 3?\n  \n**Our principal architectural limitation**\n\nOur semantic and spine outputs are both binary probability maps. The spine target is the union of the individual annotation spines for the selected annotation pass.\n\nThat means:\n- The model learns where filament material is.\n- It learns where spine-like structures occur.\n- It does not learn which spine belongs to which filament as an explicit instance identity.\n- It does not directly learn barb locations or barb direction.\nThe distinction matters because the auxiliary spine can be an excellent continuity cue without necessarily solving instance segmentation.\n","metadata":{}},{"cell_type":"markdown","source":"## Day-Wise Photofilament audit\n\nDepending on how the data is distributed across dates, the occurence and position of filaments might change...Observations from different observatories but on the same day might show same filaments - Thus data leakage during split remains a concern. Our original stratification was based on observatory and instance-count quartile, not observation date. Let's have a quick audit for data based stratification.","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# A1 RESEARCH AUDIT: OBSERVATION-DATE FOLD OVERLAP\n# ============================================================\n\nassert \"photo_df\" in globals()\n\ndate_audit = photo_df[\n    [\"file_name\", \"fold\"]\n].copy()\n\n# Filename begins YYYYMMDDHHMMSS...\ndate_audit[\"obs_date\"] = (\n    date_audit[\"file_name\"]\n    .astype(str)\n    .str.extract(r\"^(\\d{8})\", expand=False)\n)\n\nassert date_audit[\"obs_date\"].notna().all()\n\ndate_audit[\"fold\"] = date_audit[\"fold\"].astype(int)\n\n# Count photographs and distinct folds for each observation date.\ndate_summary = (\n    date_audit\n    .groupby(\"obs_date\")\n    .agg(\n        n_photos=(\"file_name\", \"nunique\"),\n        n_folds=(\"fold\", \"nunique\"),\n        folds=(\"fold\", lambda x: tuple(sorted(set(x))))\n    )\n    .sort_values(\n        [\"n_folds\", \"n_photos\"],\n        ascending=False\n    )\n)\n\n# Any date represented in more than one fold.\ncross_fold_dates = date_summary[\n    date_summary[\"n_folds\"] > 1\n]\n\n# Specifically assess the current Fold0 validation dates.\nvalidation_dates = set(\n    date_audit.loc[\n        date_audit[\"fold\"] == 0,\n        \"obs_date\"\n    ]\n)\n\ntraining_dates = set(\n    date_audit.loc[\n        date_audit[\"fold\"] != 0,\n        \"obs_date\"\n    ]\n)\n\nfold0_train_date_overlap = (\n    validation_dates & training_dates\n)\n\nprint(\"=\" * 65)\nprint(\"OBSERVATION-DATE SPLIT AUDIT\")\nprint(\"=\" * 65)\n\nprint(\"Physical photographs:\", len(date_audit))\n\nprint(\"Unique UTC dates:\", date_audit[\"obs_date\"].nunique())\n\nprint(\"Dates shared across any folds:\", len(cross_fold_dates))\n\nprint(\n    \"Dates shared specifically between Fold0 and training:\",\n    len(fold0_train_date_overlap)\n)\n\nprint(\n    \"Fold0 validation photographs:\",\n    (date_audit[\"fold\"] == 0).sum()\n)\n\nprint(\n    \"Training photographs:\",\n    (date_audit[\"fold\"] != 0).sum()\n)\n\nif len(fold0_train_date_overlap):\n\n    print(\"\\nDates shared between Fold0 and training:\")\n\n    display(\n        date_audit[\n            date_audit[\"obs_date\"].isin(\n                fold0_train_date_overlap\n            )\n        ].sort_values(\n            [\"obs_date\", \"fold\", \"file_name\"]\n        )\n    )\n\nelse:\n\n    print(\n        \"\\nNo exact UTC-date overlap between Fold0 \"\n        \"and training photographs.\"\n    )\n\nprint(\"\\nDate grouping audit complete.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}