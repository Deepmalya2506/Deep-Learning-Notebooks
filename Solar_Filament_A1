---------------------------------------\n# 2. Helper: inspect gradients\n# ------------------------------------------------------------\n\ndef a1_inspect_gradients(model):\n\n    bad_parameters = []\n    missing_parameters = []\n\n    squared_norm = 0.0\n    max_abs_gradient = 0.0\n    gradient_count = 0\n\n    for name, parameter in model.named_parameters():\n\n        if not parameter.requires_grad:\n            continue\n\n        grad = parameter.grad\n\n        if grad is None:\n            missing_parameters.append(name)\n            continue\n\n        if not torch.isfinite(grad).all().item():\n            bad_parameters.append(name)\n            continue\n\n        grad_fp32 = grad.detach().float()\n\n        squared_norm += (\n            grad_fp32.square().sum().item()\n        )\n\n        max_abs_gradient = max(\n            max_abs_gradient,\n            grad_fp32.abs().max().item()\n        )\n\n        gradient_count += 1\n\n    total_norm = squared_norm ** 0.5\n\n    return {\n        \"bad\": bad_parameters,\n        \"missing\": missing_parameters,\n        \"norm\": total_norm,\n        \"max_abs\": max_abs_gradient,\n        \"gradient_count\": gradient_count\n    }\n\n\n# ------------------------------------------------------------\n# 3. FP32 forward/backward test (no AMP, no scaler)\n# ------------------------------------------------------------\n\na1_model.zero_grad(set_to_none=True)\n\nwith torch.autocast(\n    device_type=\"cuda\",\n    enabled=False\n):\n\n    fp32_logits = a1_model(x_diag)\n\n    fp32_losses = a1_loss_function(\n        logits=fp32_logits,\n        targets=y_diag,\n        spine_pos_weight=spine_pos_weight,\n        lambda_spine=A1_CONFIG[\"lambda_spine\"]\n    )\n\n    fp32_loss = fp32_losses[\"total\"]\n\nfp32_loss.backward()\n\nfp32_report = a1_inspect_gradients(a1_model)\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"FP32 DIAGNOSTIC\")\nprint(\"=\" * 65)\n\nprint(\"Loss:\", fp32_loss.item())\nprint(\"Logit dtype:\", fp32_logits.dtype)\nprint(\"Non-finite gradient parameters:\",\n      len(fp32_report[\"bad\"]))\n\nprint(\"Missing gradient parameters:\",\n      len(fp32_report[\"missing\"]))\n\nprint(\"Gradient norm:\", fp32_report[\"norm\"])\nprint(\"Maximum absolute gradient:\",\n      fp32_report[\"max_abs\"])\n\nif fp32_report[\"bad\"]:\n    print(\"Non-finite parameters:\",\n          fp32_report[\"bad\"][:10])\n\nFP32_PASSED = (\n    len(fp32_report[\"bad\"]) == 0\n    and fp32_report[\"gradient_count\"] > 0\n    and fp32_report[\"norm\"] > 0\n)\n\nprint(\"FP32 backward:\", \"PASSED\" if FP32_PASSED else \"FAILED\")\n\n\n# ------------------------------------------------------------\n# 4. AMP diagnostic with progressively smaller scales\n# ------------------------------------------------------------\n\nAMP_PASSED = False\nAMP_SUCCESS_SCALE = None\n\nif FP32_PASSED:\n\n    print(\"\\n\" + \"=\" * 65)\n    print(\"AMP GRADIENT-SCALE DIAGNOSTIC\")\n    print(\"=\" * 65)\n\n    for initial_scale in [1024.0, 256.0, 64.0]:\n\n        a1_model.zero_grad(set_to_none=True)\n\n        amp_optimizer_test = torch.optim.AdamW(\n            a1_model.parameters(),\n            lr=A1_CONFIG[\"learning_rate\"],\n            weight_decay=A1_CONFIG[\"weight_decay\"]\n        )\n\n        amp_scaler_test = torch.amp.GradScaler(\n            \"cuda\",\n            init_scale=initial_scale,\n            growth_interval=2000\n        )\n\n        with torch.autocast(\n            device_type=\"cuda\",\n            dtype=torch.float16,\n            enabled=True\n        ):\n\n            amp_logits = a1_model(x_diag)\n\n            amp_losses = a1_loss_function(\n                logits=amp_logits.float(),\n                targets=y_diag,\n                spine_pos_weight=spine_pos_weight,\n                lambda_spine=A1_CONFIG[\"lambda_spine\"]\n            )\n\n            amp_loss = amp_losses[\"total\"]\n\n        amp_scaler_test.scale(\n            amp_loss\n        ).backward()\n\n        # Unscale 