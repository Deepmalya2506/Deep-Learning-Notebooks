A1.13: COMPLETE ACCUMULATED OPTIMIZER-UPDATE PREFLIGHT\n# ============================================================\n\nimport copy\nimport random\n\nfrom torch.nn.utils import clip_grad_norm_\n\nassert \"train_batch\" in globals()\n\n# Save the original model state, including BatchNorm buffers.\na1_preflight_state = {\n    key: value.detach().cpu().clone()\n    for key, value in a1_model.state_dict().items()\n}\n\n# Preserve RNG states so the test does not perturb training.\na1_rng_cpu = torch.get_rng_state().clone()\na1_rng_cuda = [\n    state.clone()\n    for state in torch.cuda.get_rng_state_all()\n]\na1_rng_numpy = np.random.get_state()\na1_rng_python = random.getstate()\n\n# Full physical-photo batch: normally 2 * 25 = 50 tiles.\npreflight_images = train_batch[\"images\"].reshape(\n    -1, 1, 512, 512\n)\n\npreflight_targets = train_batch[\"targets\"].reshape(\n    -1, 2, 512, 512\n)\n\nN_PREFLIGHT_TILES = len(preflight_images)\nA1_MICRO_BATCH = 8\n\nassert N_PREFLIGHT_TILES == 50\n\nhead_weight_before = (\n    a1_model.segmentation_head[0].weight\n    .detach()\n    .float()\n    .cpu()\n    .clone()\n)\n\nA1_INITIAL_SCALE = None\npreflight_succeeded = False\n\n# Try the known-good scale first, then smaller scales if the\n# accumulated full-photo batch needs a more conservative scale.\nfor trial_scale in [1024.0, 512.0, 256.0, 128.0]:\n\n    # Reset model and RNG before each attempt.\n    a1_model.load_state_dict(a1_preflight_state)\n\n    torch.set_rng_state(a1_rng_cpu)\n    torch.cuda.set_rng_state_all(a1_rng_cuda)\n    np.random.set_state(a1_rng_numpy)\n    random.setstate(a1_rng_python)\n\n    a1_model.train()\n\n    trial_optimizer = torch.optim.AdamW(\n        a1_model.parameters(),\n        lr=A1_CONFIG[\"learning_rate\"],\n        weight_decay=A1_CONFIG[\"weight_decay\"]\n    )\n\n    trial_scaler = torch.amp.GradScaler(\n        \"cuda\",\n        init_scale=trial_scale,\n        growth_interval=2000,\n        enabled=True\n    )\n\n    trial_optimizer.zero_grad(set_to_none=True)\n\n    accumulated_loss = 0.0\n\n    for start in range(\n        0,\n        N_PREFLIGHT_TILES,\n        A1_MICRO_BATCH\n    ):\n\n        end = min(\n            start + A1_MICRO_BATCH,\n            N_PREFLIGHT_TILES\n        )\n\n        x, y = augment_and_normalize(\n            preflight_images[start:end],\n            preflight_targets[start:end],\n            mean=normalization_stats[\"mean\"],\n            std=normalization_stats[\"std\"],\n            training=True\n        )\n\n        x = x.to(device, non_blocking=True)\n\n        y = y.to(\n            device,\n            dtype=torch.float32,\n            non_blocking=True\n        )\n\n        with torch.autocast(\n            device_type=\"cuda\",\n            dtype=torch.float16,\n            enabled=True\n        ):\n\n            logits = a1_model(x)\n\n        if not torch.isfinite(logits).all().item():\n            raise RuntimeError(\n                \"Non-finite model logits during optimizer preflight.\"\n            )\n\n        losses = a1_loss_function(\n            logits=logits.float(),\n            targets=y,\n            spine_pos_weight=spine_pos_weight,\n            lambda_spine=A1_CONFIG[\"lambda_spine\"]\n        )\n\n        loss = losses[\"total\"]\n\n        if not torch.isfinite(loss).item():\n            raise RuntimeError(\n                \"Non-finite loss during optimizer preflight.\"\n            )\n\n        chunk_weight = (end - start) / N_PREFLIGHT_TILES\n\n        trial_scaler.scale(\n            loss * chunk_weight\n        ).backward()\n\n        accumulated_loss += (\n            loss.detach().item() * chunk_weight\n        )\n\n        del x, y, logits, losses, loss\n\n    # Unscale only once after all microbatch gradients accumulate.\n    trial_scaler.unscale_(trial_optimizer)\n\n    grad_norm = clip_grad_norm_(\n        a1_model.parameters(),\n        max_norm=A1_CONFIG[\"gradient_clip\"]\n    )\n\n    old_scale = trial_scaler.get_scale()\n\n    trial_scaler.step(trial_optimizer)\n    trial_scaler.update()\n\n    new_scale = trial_scaler.get_scale()\n\n    was_skipped = new_scale < old_scale\n\n    head_weight_after = (\n        a1_model.segmentation_head[0].weight\n        .detach()\n        .float()\n        .cpu()\n    )\n\n    max_parameter_change = (\n        head_weight_after - head_weight_before\n    ).abs().max().item()\n\n    print(f\"\\nScale tested: {trial_scale:g}\")\n    print(f\"Accumulated loss: {accumulated_loss:.6f}\")\n    print(f\"Gradient norm before clipping: {grad_norm.item():.6f}\")\n    print(f\"New scaler value: {new_scale:g}\")\n    print(f\"Optimizer update skipped: {was_skipped}\")\n    print(f\"Maximum head-weight change: {max_parameter_change:.8e}\")\n\n    if (\n        not was_skipped\n        and torch.isfinite(grad_norm).item()\n        and max_parameter_change > 0\n    ):\n\n        A1_INITIAL_SCALE = trial_scale\n        preflight_succeeded = True\n\n        print(\"Complete accumulated optimizer update: PASSED\")\n        break\n\n    del trial_optimizer, trial_scaler\n    torch.cuda.empty_cache()\n\n\n# Restore the exact initial model weights.\na1_model.load_state_dict(a1_preflight_state)\n\n# Restore RNG states.\ntorch.set_rng_state(a1_rng_cpu)\ntorch.cuda.set_rng_state_all(a1_rng_cuda)\nnp.random.set_state(a1_rng_numpy)\nrandom.setstate(a1_rng_python)\n\na1_model.train()\n\ndel a1_preflight_state\n\ntorch.cuda.empty_cache()\n\nassert preflight_succeeded, (\n    \"The complete accumulated optimizer update failed. \"\n    \"Do not start full training.\"\n)\n\n# Freeze the working AMP setting.\nA1_CONFIG[\"amp_initial_scale\"] = A1_INITIAL_SCALE\n\natomic_json_save(\n    A1_CONFIG,\n    RUN_ROOT / \"experiment_config.json\"\n)\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"A1.13 PREFLIGHT PASSED\")\nprint(\"Chosen initial AMP scale:\", A1_INITIAL_SCALE)\nprint(\"Original model weights restored.\")\nprint(\"=\" * 65)","metadata":{"trusted":true},"outputs":[],"execu