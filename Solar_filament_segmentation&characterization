- Sample Annotation Entry ---\n{\n  \"segmentation\": \"[170 coordinate values]\",\n  \"area\": 750.0,\n  \"iscrowd\": 0,\n  \"spine\": \"[54 coordinate values]\",\n  \"image_id\": \"040301-20140609195854Bh\",\n  \"bbox\": [\n    388.4121,\n    799.966,\n    92.52639999999997,\n    52.485000000000014\n  ],\n  \"category_id\": 2,\n  \"id\": \"d7fd9cdb-3f34-4dfc-a1fa-c1fd25110a98\"\n}\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"# Mask Rasterization - Visual Overlay gen.\n\nThe given annotations coco json contains the polygon coordinates identifying the objects(filaments) in each images - This is done for efficient storage of entities from each image over storing the entire mask in gigabytes.\n\nBut Neural Networks understands tensors and not 2d cooridnates - thus we need to rasterize them into masks ","metadata":{}},{"cell_type":"code","source":"import cv2\nimport numpy as np","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:06.040706Z","iopub.execute_input":"2026-08-15T14:05:06.041038Z","iopub.status.idle":"2026-08-15T14:05:06.422058Z","shell.execute_reply.started":"2026-08-15T14:05:06.04101Z","shell.execute_reply":"2026-08-15T14:05:06.419829Z"}},"outputs":[],"execution_count":7},{"cell_type":"markdown","source":"## Mapping image files to their respective annotations","metadata":{}},{"cell_type":"code","source":"image_id_to_anns = defaultdict(list)\nfor ann in coco_data[\"annotations\"]:\n    image_id_to_anns[ann[\"image_id\"]].append(ann)\n\nprint(f\"Mapped annotations for {len(image_id_to_anns)} unique image IDs.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:06.423134Z","iopub.execute_input":"2026-08-15T14:05:06.423406Z","iopub.status.idle":"2026-08-15T14:05:06.464015Z","shell.execute_reply.started":"2026-08-15T14:05:06.423382Z","shell.execute_reply":"2026-08-15T14:05:06.463045Z"}},"outputs":[{"name":"stdout","text":"Mapped annotations for 1154 unique image IDs.\n","output_type":"stream"}],"execution_count":8},{"cell_type":"markdown","source":"## Polygon & Spine Rasterization ","metadata":{}},{"cell_type":"code","source":"def create_filament_mask(annotations, height=2048, width=2048):\n    \"\"\"\n    Converts COCO polygon annotations into:\n    1. Combined binary semantic mask (height, width) -> 0: background, 1: filament body\n    2. Spine centerline mask (height, width)         -> 0: background, 1: spine line\n    3. List of per-instance binary masks [(height, width), ...]\n    \"\"\"\n    combined_mask = np.zeros((height, width), dtype=np.uint8)\n    spine_mask = np.zeros((height, width), dtype=np.uint8)\n    instance_masks = []\n\n    for ann in annotations:\n        # --- A. Polygon Body Rasterization ---\n        seg = ann.get(\"segmentation\", [])\n        if isinstance(seg, list) and len(seg) > 0:\n            # Reshape [x0, y0, x1, y1, ...] into (N, 1, 2) integer array for OpenCV\n            pts = np.array(seg[0], dtype=np.float32).reshape((-1, 2)).astype(np.int32)\n            \n            inst_mask = np.zeros((height, width), dtype=np.uint8)\n            cv2.fillPoly(inst_mask, [pts], 1)\n\n            # Merge instance into combined semantic mask\n            combined_mask = np.maximum(combined_mask, inst_mask)\n            instance_masks.append(inst_mask)\n\n        # --- B. Spine Centerline Rasterization ---\n        spine_coords = ann.get(\"spine\", [])\n        if spine_coords and len(spine_coords) >= 4:\n            spine_pts = np.array(spine_coords, dtype=np.float32).reshape((-1, 2)).astype(np.int32)\n            # Draw line segments along the spine path\n            cv2.polylines(spine_mask, [spine_pts], isClosed=False, color=1, thickness=2)\n\n    return combined_mask, spine_mask, instance_masks","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:06.465161Z","iopub.execute_input":"2026-08-15T14:05:06.465562Z","iopub.status.idle":"2026-08-15T14:05:06.49566Z","shell.execute_reply.started":"2026-08-15T14:05:06.465534Z","shell.execute_reply":"2026-08-15T14:05:06.494449Z"}},"outputs":[],"execution_count":9},{"cell_type":"markdown","source":"## Sample test of rasterizer on first image","metadata":{}},{"cell_type":"code","source":"sample_img_info = images_list[0]\nsample_img_id = sample_img_info[\"id\"]\nsample_file_name = sample_img_info[\"file_name\"]\nsample_anns = image_id_to_anns[sample_img_id]\n\nprint(f\"\\n--- Testing Rasterizer ---\")\nprint(f\"Sample Image ID:   {sample_img_id}\")\nprint(f\"Physical File:     {sample_file_name}\")\nprint(f\"Filament Count:    {len(sample_anns)}\")\n\ncombined_mask, spine_mask, inst_masks = create_filament_mask(\n    sample_anns, \n    sample_img_info[\"height\"], \n    sample_img_info[\"width\"]\n)\n\ntotal_filament_pixels = np.sum(combined_mask)\ntotal_disk_pixels = 2048 * 2048\ncoverage_pct = (total_filament_pixels / total_disk_pixels) * 100\n\nprint(f\"Rasterized Mask Shape: {combined_mask.shape}\")\nprint(f\"Total Filament Pixels: {total_filament_pixels} ({coverage_pct:.4f}% of total disk)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:06.496571Z","iopub.execute_input":"2026-08-15T14:05:06.496835Z","iopub.status.idle":"2026-08-15T14:05:06.569041Z","shell.execute_reply.started":"2026-08-15T14:05:06.496815Z","shell.execute_reply":"2026-08-15T14:05:06.568088Z"}},"outputs":[{"name":"stdout","text":"\n--- Testing Rasterizer ---\nSample Image ID:   040301-20140609195854Bh\nPhysical File:     20140609195854Bh.jpeg\nFilament Count:    12\nRasterized Mask Shape: (2048, 2048)\nTotal Filament Pixels: 18663 (0.4450% of total disk)\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"## Visual Overlay","metadata":{}},{"cell_type":"code","source":"img_path = TRAIN_IMG_DIR / sample_file_name\n\nif img_path.exists():\n    raw_img = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)\nelse:\n    print(f\"\\n[Note] Image file not found at {img_path}. Creating synthetic grayscale disk for preview.\")\n    raw_img = np.full((2048, 2048), 120, dtype=np.uint8)\n\n# Convert grayscale solar disk to RGB for color overlay\noverlay_img = cv2.cvtColor(raw_img, cv2.COLOR_GRAY2RGB)\n\n# Color masks: Red for Filament Body, Cyan for Spine Centerlines\noverlay_img[combined_mask == 1] = [255, 50, 50]\noverlay_img[spine_mask == 1] = [0, 255, 255]\n\n# Render comparison plots\nfig, axes = plt.subplots(1, 3, figsize=(18, 6))\n\naxes[0].imshow(raw_img, cmap=\"gray\")\naxes[0].set_title(f\"Original Solar Disk\\n({sample_file_name})\")\naxes[0].axis(\"off\")\n\naxes[1].imshow(combined_mask, cmap=\"magma\")\naxes[1].set_title(f\"Rasterized Semantic Mask\\n({len(inst_masks)} Filaments)\")\naxes[1].axis(\"off\")\n\naxes[2].imshow(overlay_img)\naxes[2].set_title(\"Visual Overlay\\n(Red: Body | Cyan: Spine)\")\naxes[2].axis(\"off\")\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:06.570119Z","iopub.execute_input":"2026-08-15T14:05:06.570386Z","iopub.status.idle":"2026-08-15T14:05:08.281798Z","shell.execute_reply.started":"2026-08-15T14:05:06.570363Z","shell.execute_reply":"2026-08-15T14:05:08.280678Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1800x600 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"cell_type":"markdown","source":"## Key Note\n\n***create_filament_mask()*** reads the coordinate points from the JSON, reshapes them into $(x, y)$ pairs, and uses cv2.fillPoly to paint a 2D matrix of shape (2048, 2048).\n\n**Class Imbalance**: Notice the printed coverage percentage (usually under 0.5% of the full image). This visually proves why we need to crop images into tiles rather than passing empty space into our neural network!\n\nOverlay Sanity Check: In the rightmost plot, red areas show the exact boundaries where filaments sit, while the cyan lines trace their central spines.","metadata":{}},{"cell_type":"markdown","source":"# Ingestion and Utility Pipeline Setup\n\nWhen our model makes predictions at inference time, we cannot submit raw $2048 \\times 2048$ image files. Kaggle expects a CSV containing Run-Length Encoded (RLE) strings for every detected instance.\n\n**Lossless Roundtripping Verification**: A simple 1-pixel shift or transposing $(x, y) \\to (y, x)$ in our RLE encoder will silently reduce the model's score. This cell builds the encoder/decoder functions using pycocotools and performs a unit test to guarantee $100\\%$ lossless roundtripping.","metadata":{}},{"cell_type":"code","source":"import numpy as np\nfrom pycocotools import mask as mask_utils","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:08.282783Z","iopub.execute_input":"2026-08-15T14:05:08.283071Z","iopub.status.idle":"2026-08-15T14:05:08.298628Z","shell.execute_reply.started":"2026-08-15T14:05:08.283047Z","shell.execute_reply":"2026-08-15T14:05:08.29712Z"}},"outputs":[],"execution_count":12},{"cell_type":"markdown","source":"## Binary Mask <--> RLE String interconverter","metadata":{}},{"cell_type":"code","source":"def mask_to_rle(binary_mask):\n    \"\"\"\n    Converts a 2D binary numpy array (uint8, 0 or 1) into a COCO/Kaggle standard RLE string.\n    Fortran order ('F') is required by pycocotools to match column-major standards.\n    \"\"\"\n    if not isinstance(binary_mask, np.ndarray):\n        binary_mask = np.array(binary_mask)\n        \n    # Ensure binary uint8 format\n    binary_mask = (binary_mask > 0).astype(np.uint8)\n    \n    # pycocotools expects Fortran-contiguous array (column-major order)\n    fortran_mask = np.asfortranarray(binary_mask)\n    rle = mask_utils.encode(fortran_mask)\n    \n    # Decode byte string to standard UTF-8 string for CSV export\n    rle[\"counts\"] = rle[\"counts\"].decode(\"utf-8\")\n    return rle\n\ndef rle_to_mask(rle_dict, height=2048, width=2048):\n    \"\"\"\n    Decodes an RLE dictionary/string back into a 2D binary numpy array (height, width).\n    \"\"\"\n    # If passed as raw string/counts dict, structure correctly for pycocotools\n    if isinstance(rle_dict, str):\n        rle_dict = {\"size\": [height, width], \"counts\": rle_dict.encode(\"utf-8\")}\n    elif isinstance(rle_dict, dict) and isinstance(rle_dict[\"counts\"], str):\n        rle_dict = rle_dict.copy()\n        rle_dict[\"counts\"] = rle_dict[\"counts\"].encode(\"utf-8\")\n        \n    binary_mask = mask_utils.decode(rle_dict)\n    return binary_mask.astype(np.uint8)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:08.30059Z","iopub.execute_input":"2026-08-15T14:05:08.301069Z","iopub.status.idle":"2026-08-15T14:05:08.321636Z","shell.execute_reply.started":"2026-08-15T14:05:08.301026Z","shell.execute_reply":"2026-08-15T14:05:08.32063Z"}},"outputs":[],"execution_count":13},{"cell_type":"markdown","source":"## Sample test of the Mask <-> RLE encoder/decoder on sample image","metadata":{}},{"cell_type":"code","source":"print(\"--- Running RLE Roundtrip Verification Test ---\")\n\n# Pick the first individual instance mask from our previous work\ntest_instance = inst_masks[0]\n\n# 1. Encode mask to RLE\nencoded_rle = mask_to_rle(test_instance)\n\n# 2. Decode RLE back to mask\ndecoded_mask = rle_to_mask(encoded_rle, height=2048, width=2048)\n\n# 3. Check exact equality across all 4.19 million pixels\nis_identical = np.array_equal(test_instance, decoded_mask)\ncompression_ratio = (len(str(encoded_rle[\"counts\"])) / (2048 * 2048)) * 100\n\nprint(f\"Original Mask Shape:   {test_instance.shape}\")\nprint(f\"RLE Compact Output:   {str(encoded_rle['counts'])[:60]}...\")\nprint(f\"Compression Efficiency: {compression_ratio:.5f}% of original pixel size\")\nprint(f\"Lossless Match Check:  {'✅ PASSED (100% Match)' if is_identical else '❌ FAILED (Mismatch Found)'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:08.322956Z","iopub.execute_input":"2026-08-15T14:05:08.323253Z","iopub.status.idle":"2026-08-15T14:05:08.391883Z","shell.execute_reply.started":"2026-08-15T14:05:08.323226Z","shell.execute_reply":"2026-08-15T14:05:08.391153Z"}},"outputs":[{"name":"stdout","text":"--- Running RLE Roundtrip Verification Test ---\nOriginal Mask Shape:   (2048, 2048)\nRLE Compact Output:   UiXh04ko14M000011N1O1O01O0O1O1N3O1OO1O1000O01001O0000O1O1O1O...\nCompression Efficiency: 0.00527% of original pixel size\nLossless Match Check:  ✅ PASSED (100% Match)\n","output_type":"stream"}],"execution_count":14},{"cell_type":"markdown","source":"# Grid Tiling, Filtering & Patch Reconstruction Engine","metadata":{}},{"cell_type":"markdown","source":"* **The Resolution Dilemma:** Resizing $2048 \\times 2048$ images down to $512 \\times 512$ erases thin 1-to-2-pixel-wide barbs. But feeding raw $2048 \\times 2048$ images into PyTorch exhausts GPU memory rapidly.\n\n* **The Sliding Window Solution:** Slicing the full solar disk into $512 \\times 512$ tiles preserves $100\\%$ of spatial detail.\n\n* **Training Optimization (Filtering Empty Tiles)**: Over 80% of tiles on a solar image are pure background space. By filtering for tiles that actually contain filament pixels (plus a small fraction of background tiles), training becomes 5x to 10x faster.\n\n* **Inference Stitching (Overlap Averaging)**: During test time, we slide across the image with overlapping tiles and average prediction probabilities in overlap zones to prevent sharp seam artifacts at tile edges.\n\n<div align=\"center\">\n    \n```\nFULL SOLAR DISK (2048 x 2048)                    GRID OF 512 x 512 TILES\n┌───────────────────────────────────┐        ┌───────┬───────┬───────┬───────┐\n│                                   │        │Tile 1 │Tile 2 │Tile 3 │Tile 4 │\n│            .──.                   │        ├───────┼───────┼───────┼───────┤\n│           (    )  ◄── Filament    │  ──►   │Tile 5 │Tile 6 │Tile 7 │Tile 8 │\n│            `──'                   │        ├───────┼───────┼───────┼───────┤\n│                                   │        │Tile 9 │Tile 10│Tile 11│Tile 12│\n│                                   │        ├───────┼───────┼───────┼───────┤\n│                                   │        │Tile 13│Tile 14│Tile 15│Tile 16│\n└───────────────────────────────────┘        └───────┴───────┴───────┴───────┘\n```\n","metadata":{}},{"cell_type":"markdown","source":"## Tile Extraction Function (For Training & Feature Prep)","metadata":{}},{"cell_type":"code","source":"def extract_tiles(image, mask, spine_mask=None, tile_size=512, stride=384, min_filament_pixels=0):\n    \"\"\"\n    Slices a 2048x2048 image and mask into tile_size x tile_size patches.\n    \n    Args:\n        image: (H, W) or (H, W, C) numpy array\n        mask: (H, W) binary mask array\n        spine_mask: (H, W) spine mask array (optional)\n        tile_size: Height/Width of square tiles (default 512)\n        stride: Step size between tiles (stride < tile_size creates overlap)\n        min_filament_pixels: Minimum positive mask pixels required to keep a tile.\n                            Set to 0 to keep all tiles (useful for inference).\n    \n    Returns:\n        tiles_dict: List of dicts containing image_patch, mask_patch, spine_patch, (y, x) coords\n    \"\"\"\n    h, w = image.shape[:2]\n    tiles = []\n\n    # Calculate top-left starting positions for sliding window\n    y_steps = list(range(0, h - tile_size + 1, stride))\n    x_steps = list(range(0, w - tile_size + 1, stride))\n    \n    # Ensure edge boundaries cover the entire image\n    if y_steps[-1] + tile_size < h:\n        y_steps.append(h - tile_size)\n    if x_steps[-1] + tile_size < w:\n        x_steps.append(w - tile_size)\n\n    for y in y_steps:\n        for x in x_steps:\n            img_tile = image[y:y+tile_size, x:x+tile_size]\n            mask_tile = mask[y:y+tile_size, x:x+tile_size]\n            spine_tile = spine_mask[y:y+tile_size, x:x+tile_size] if spine_mask is not None else None\n            \n            filament_pixel_count = np.sum(mask_tile > 0)\n            \n            # Keep tile if it passes minimum pixel threshold\n            if filament_pixel_count >= min_filament_pixels:\n                tiles.append({\n                    \"img_tile\": img_tile,\n                    \"mask_tile\": mask_tile,\n                    \"spine_tile\": spine_tile,\n                    \"coords\": (y, x, tile_size, tile_size),\n                    \"pixel_count\": filament_pixel_count\n                })\n\n    return tiles","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:08.392751Z","iopub.execute_input":"2026-08-15T14:05:08.392998Z","iopub.status.idle":"2026-08-15T14:05:08.400301Z","shell.execute_reply.started":"2026-08-15T14:05:08.392974Z","shell.execute_reply":"2026-08-15T14:05:08.399141Z"}},"outputs":[],"execution_count":15},{"cell_type":"markdown","source":"## Tile Reconstruction Function (Stitches Tiles back into 2048x2048)","metadata":{}},{"cell_type":"code","source":"def reconstruct_from_tiles(tiles, full_shape=(2048, 2048)):\n    \"\"\"\n    Reconstructs full-resolution predictions from predicted tile patches,\n    using linear accumulation to smoothly average overlapping tile borders.\n    \"\"\"\n    reconstructed_mask = np.zeros(full_shape, dtype=np.float32)\n    weight_map = np.zeros(full_shape, dtype=np.float32)\n\n    for tile_info in tiles:\n        y, x, h, w = tile_info[\"coords\"]\n        pred_patch = tile_info[\"mask_tile\"]\n\n        reconstructed_mask[y:y+h, x:x+w] += pred_patch\n        weight_map[y:y+h, x:x+w] += 1.0\n\n    # Avoid division by zero in untouched background areas\n    weight_map = np.maximum(weight_map, 1.0)\n    averaged_mask = reconstructed_mask / weight_map\n    \n    return averaged_mask","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-15T14:05:08.40119Z","iopub.execute_input":"2026-08-15T14:05:08.401457Z","iopub.status.idle":"2026-08-15T14:05:08.431337Z","shell.execute_reply